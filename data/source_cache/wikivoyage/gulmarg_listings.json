    "wikidata_id": "Q1554360",
    "wikipedia_title": "Gulmarg Gondola",
    "commons_image": "Gulmarg-Gondala.JPG",
    "lastedit": null,
    "prose": {
      "text": "The two-stage high altitude cable car is popularly known as Gondola. The first phase operates from Gulmarg to Kongdori. The second phase starts from Kongdori and goes up to the shoulder of Afarwat Peak. Kongdori is connected to the beautiful meadows of Khilanmarg (3 km one way). The second and the higher stops connect to Alpathar Lake, a high altitude lake, which remains frozen for most part of the year.",
      "license": "CC-BY-SA-4.0",
      "source_article": "https://en.wikivoyage.org/wiki/Gulmarg",
      "retrieved_at": "2026-09-19T19:52:51.529757+00:00"
    },
