{
  "$defs": {
    "CoordinatePayload": {
      "additionalProperties": false,
      "properties": {
        "coordinate_sources": {
          "items": {
            "$ref": "#/$defs/CoordinatePoint"
          },
          "maxItems": 10,
          "title": "Coordinate Sources",
          "type": "array"
        }
      },
      "title": "CoordinatePayload",
      "type": "object"
    },
    "CoordinatePoint": {
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude",
        "source_id",
        "source_url"
      ],
      "title": "CoordinatePoint",
      "type": "object"
    },
    "CoordinateResult": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^research_[a-f0-9]{24}$",
          "title": "Task Id",
          "type": "string"
        },
        "place_id": {
          "maxLength": 250,
          "minLength": 1,
          "title": "Place Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "FOUND",
            "PARTIAL",
            "UNRESOLVED",
            "CONFLICT"
          ],
          "title": "Status",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 10,
          "title": "Sources",
          "type": "array"
        },
        "research_notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Research Notes",
          "type": "string"
        },
        "type": {
          "const": "COORDINATE_RESEARCH",
          "title": "Type",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/CoordinatePayload"
        }
      },
      "required": [
        "task_id",
        "place_id",
        "status",
        "type",
        "result"
      ],
      "title": "CoordinateResult",
      "type": "object"
    },
