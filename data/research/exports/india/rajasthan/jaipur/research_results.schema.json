  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "handoff_id": {
      "pattern": "^handoff_[a-f0-9]{24}$",
      "title": "Handoff Id",
      "type": "string"
    },
    "results": {
      "items": {
        "discriminator": {
          "mapping": {
            "COORDINATE_RESEARCH": "#/$defs/CoordinateResult",
            "DESCRIPTION": "#/$defs/DescriptionResult",
            "IDENTITY_RESEARCH": "#/$defs/IdentityResult",
            "OPENING_HOURS": "#/$defs/HoursResult",
            "REAL_PRIMARY_IMAGE": "#/$defs/ImageResult",
            "WEBSITE": "#/$defs/WebsiteResult"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HoursResult"
          },
          {
            "$ref": "#/$defs/ImageResult"
          },
          {
            "$ref": "#/$defs/WebsiteResult"
          },
          {
            "$ref": "#/$defs/DescriptionResult"
          },
          {
            "$ref": "#/$defs/CoordinateResult"
          },
          {
            "$ref": "#/$defs/IdentityResult"
          }
        ]
      },
      "maxItems": 5000,
      "title": "Results",
      "type": "array"
    }
  },
  "required": [
    "handoff_id",
    "results"
