# Optional environment variables
# The core open-data pipeline works without any paid API keys.
# HTTP User-Agent header for OpenStreetMap / Wikidata / Wikimedia APIs
DATAFACTORY_USER_AGENT="YatraCanvas-DataFactory/1.0 (contact: info@yatracanvas.org)"

# Optional custom Overpass mirror URL
# OVERPASS_URL="https://lz4.overpass-api.de/api/interpreter"

# Cache TTL in seconds (default 7 days)
CACHE_TTL_SECONDS=604800

GROQ_API_KEY=
GEMINI_API_KEY=
AI_MODE=FREE_ONLY
AI_ENABLED=true
# Set true only for keys on confirmed free accounts (no paid billing).
GROQ_FREE_TIER_CONFIRMED=false
GEMINI_FREE_TIER_CONFIRMED=false
AI_MAX_CALLS_PER_CITY=30
AI_MAX_VISION_CALLS_PER_CITY=20
AI_MAX_ESCALATIONS_PER_CITY=5

# Local models are optional. Download once explicitly, then use HF/local cache.
LOCAL_MEDIA_ENABLED=true
LOCAL_MEDIA_MODEL=google/siglip-base-patch16-224
LOCAL_MEDIA_REVISION=7fd15f0689c79d79e38b1c2e2e2370a7bf2761ed
LOCAL_MEDIA_BATCH_SIZE=4
LOCAL_MEDIA_MAX_CANDIDATES=20
LOCAL_MEDIA_THUMBNAIL_SIZE=384
LOCAL_MEDIA_ALLOW_DOWNLOAD=false
LOCAL_MEDIA_DEVICE=cpu
# Model cache defaults to data/cache/models. Set an absolute path to override.
# LOCAL_MEDIA_MODEL_CACHE=
LOCAL_MEDIA_CPU_THREADS=4
# Relevance/minimum/ambiguity settings come from config/local_media.yaml.
# Optional overrides: LOCAL_MEDIA_RELEVANCE_THRESHOLD, LOCAL_MEDIA_MIN_RELEVANCE,
# LOCAL_MEDIA_AMBIGUITY_MARGIN. Recalibrate after changing the model or prompts.
LOCAL_MEDIA_HIGH_THRESHOLD=0.85
LOCAL_MEDIA_LABEL_MARGIN=0.20
LOCAL_DUPLICATE_THRESHOLD=3
LOCAL_TEXT_ENABLED=false
LOCAL_TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_TEXT_ALLOW_DOWNLOAD=false
# python requires no Node; javascript uses optional npm opening_hours package.
HOURS_VALIDATOR_BACKEND=python
HOURS_RESEARCH_MAX_AGE_DAYS=180
