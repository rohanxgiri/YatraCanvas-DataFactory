# Optional environment variables
# The core open-data pipeline works without any paid API keys.
# HTTP User-Agent header for OpenStreetMap / Wikidata / Wikimedia APIs
DATAFACTORY_USER_AGENT="YatraCanvas-DataFactory/1.0 (contact: info@yatracanvas.org)"

# Optional custom Overpass mirror URL
# OVERPASS_URL="https://lz4.overpass-api.de/api/interpreter"

# Cache TTL in seconds (default 7 days)
CACHE_TTL_SECONDS=604800
